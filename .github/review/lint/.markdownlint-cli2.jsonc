{
  // EShop の Markdown 体裁ルール（日本語文書前提）
  // 既定ルールは有効。日本語文書に不向きな一部のみ無効化する。
  "config": {
    "default": true,
    "MD013": false, // 行長制限: 日本語の長文に不向き
    "MD031": false, // フェンス前後の空行: 観点フォーマット（「- **悪い例**:」直下にコード例）と構造的に衝突する
    "MD033": false, // inline HTML: Mermaid 等の混在を許容
    "MD041": false, // 先頭 h1: front matter があるため
  },
  "ignores": ["**/node_modules/**"],
}
